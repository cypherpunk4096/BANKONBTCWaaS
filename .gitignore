# ── dependencies & build artifacts ───────────────────────────────
node_modules/
**/target/
*.tmp
__pycache__/
*.pyc

# ── logs & runtime state (generated) ──────────────────────────────
*.log
.monitor.state
oracle-logs/
bankon-console/fast-nodes.json
bankon-console/favourite-nodes.json
bankon-console/fastpref.json
bankon-console/node-census.json
exports/

# ── per-deployment wallet registry (watch-only metadata, still local) ──
**/registry.json

# ── local operator config (may hold secrets) — see bankon.env.example ──
bankon.env

# ── large GeoIP databases (70 MB, MaxMind GeoLite2 EULA — download ────
#    separately; geoip/LICENSE is kept for attribution) ──────────────
geoip/*.mmdb

# ── bankon-vault — NEVER commit key material or vault state ────────
**/.bankon-vault/
**/vault_bankon/
*.enc
.master.key
.salt
*.psbt.signed
# also block anything obviously secret that a legacy import might drop in
*mnemonic*
*seed.txt
wallet.dat
passwords.*

# ── OS / editor cruft ─────────────────────────────────────────────
.DS_Store
*.swp
bankon-console/.history

# bankon-vault policy runtime state
**/.policy_state.json
**/.policy_audit.jsonl
*.tomb
*.tomb.key

# bankonOS enclave build artifacts
bankonos/enclave/_stage/
bankonos/enclave/*.apkovl.tar.gz
bankonos/enclave/iso/

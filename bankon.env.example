# BANKON operator config — TEMPLATE. Copy to bankon.env, then edit:
#     cp bankon.env.example bankon.env
# bankon.env is gitignored (it may hold secrets). Sourced (auto-exported) by
# ./bankon and ./bankon-qt.sh. After editing:  ./bankon stop && ./bankon up
# Never commit a real RAGE_TOKEN / ALGOD_TOKEN — keep those in bankon.env only.

# ---- rageRPC → pgvectorscale handoff (rage.pythai.net) -----------------------
# The remote ingest endpoint that loads BANKON's collected BTC node data into
# pgvectorscale. The Console's POST /api/rage/handoff gathers nodes and pushes here.
RAGE_URL=https://bankon.pythai.net
RAGE_INGEST_PATH=/ragest
# Bearer token for the ingest endpoint (sent as  Authorization: Bearer <token>).
# Paste yours here if bankon.pythai.net/ragest requires auth:
RAGE_TOKEN=

# ---- rageRPC accelerated RPC policy -----------------------------------------
# rageRPC ON by default = max throughput, adaptive (auto-throttles under IBD load).
# Set 0 for the gentle default profile (4 in-flight / 12s breaker).
BANKON_RAGE=1
# Optional explicit overrides (otherwise the rage profile decides):
# BANKON_RPC_MAX_INFLIGHT=16     # throttle ceiling (1–32)
# BANKON_RPC_DISTRESS_MS=4000    # circuit-breaker cooldown (ms)

# ---- Bitcoin Core resources (BANKON-managed; 7.6 GB RAM here) ----------------
# Full archival node UTXO cache (MiB). Chainstate is on the SSD, so the node is CPU-bound now —
# a huge dbcache adds little and risks swap. Keep ≤ 4000, and only that high with the pruned node off.
#   apply:  bankon-nodes.sh set-dbcache <MiB> full   (then restart the node)
BANKON_BTC_DBCACHE=4096
# Pruned WaaS node — kept lean + polite so it PLAYS NICE with the archival Core (yields CPU/disk):
BANKON_PRUNED_DATADIR=/home/luvai/.bitcoin-pruned   # on the local SSD (fast), not the external HDD
BANKON_PRUNED_DBCACHE=300        # small UTXO cache
BANKON_PRUNED_PAR=1              # 1 script-verify thread → leaves cores for the full node
BANKON_PRUNED_MAXCONN=20         # modest peer set
BANKON_PRUNED_NICE=15            # CPU priority (nicer) — full node wins
BANKON_PRUNED_IONICE=3           # idle I/O class — full node's disk wins

# ---- peers ------------------------------------------------------------------
# Target connection count shown in the Network tab (node maintains ~this via addnode + auto-outbound).
BANKON_PEER_TARGET=12

# ---- BANKON ALGO WaaS (Algorand twin — runs in tandem with the BTC stack) ---
# Ports count from 4444 (BTC WaaS is :8088). algod recognized from ~/.algorand/algod.{net,token}.
BANKON_ALGO_PORT=4444
# ALGOD_URL=http://127.0.0.1:8080      # override algod REST endpoint
# ALGOD_TOKEN=                          # override algod API token (else read from ~/.algorand/algod.token)

# ---- BANKON.ETH WaaS (EVM twin — Ethereum / L2s / any EVM chain) ------------
# EVM-generic: chain auto-detected via eth_chainId. Default JSON-RPC :8545.
BANKON_ETH_PORT=4448
# ETH_RPC_URL=http://127.0.0.1:8545    # any EVM node / provider (Ethereum, Polygon, Arbitrum, …)
# ETH_RPC_AUTH=                         # optional Bearer/JWT for gated RPC

# ---- ⟲ DEXY (sovereign BTC liquidity mover — CEX→DEX · DEX→DEX → YOUR keys) --
# Quotes/plans only: destination is always the user's own address (WaaS BTC
# Standard); DEXY never signs. External market data stays under /api/dexy/*.
BANKON_DEXY_PORT=8091
# DEXY_ABSORPTION_PCT=0.10             # max fraction of DEX depth to absorb per day
# DEXY_MAX_SLIP_BPS=100                # per-leg slippage ceiling
# DEXY_STRICT_CUSTODY=1                # refuse destinations not in the WaaS registry
# DEXY_FIXTURES=1                      # offline mode: serve test/fixtures instead of network
# ARRBY_URL=http://127.0.0.1:8787      # vendored ARRBY backend (EVM DEX→DEX scanner)

# ---- ports (defaults shown) -------------------------------------------------
# BANKON_CONSOLE_PORT=8090
# BANKON_CONSOLE_URL=http://127.0.0.1:8090   # used by the Qt app

# Port the backend's HTTP + WebSocket server listens on
PORT=8787

# Optional: pass watch config inline instead of watch-config.json (useful for
# containerized deploys). If set, takes priority over the JSON file.
# WATCH_CONFIG_JSON={"arbitrum":{...}}

# Optional: Tenderly simulation (backend/src/tenderly-sim.js). Leave unset to
# skip simulation entirely — nothing breaks, it just won't pre-flight-check.
# TENDERLY_ACCOUNT=
# TENDERLY_PROJECT=
# TENDERLY_ACCESS_KEY=

# Optional: mindX logging (integrations/mindx_client.js, used by signal_runner.js)
# MINDX_URL=https://mindx.pythai.net
# MINDX_KEY=

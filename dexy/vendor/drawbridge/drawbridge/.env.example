# ── RPC (mainnet-only) ─────────────────────────────────────────────
ETHEREUM_RPC=https://eth.llamarpc.com
ARBITRUM_RPC=https://arb1.arbitrum.io/rpc
BASE_RPC=https://mainnet.base.org
OPTIMISM_RPC=https://mainnet.optimism.io
POLYGON_RPC=https://polygon-rpc.com
AVALANCHE_RPC=https://api.avax.network/ext/bc/C/rpc
ARC_RPC=                              # set at Circle Arc mainnet-beta launch

# ── explorers (verification) ───────────────────────────────────────
ETHERSCAN_KEY=
ARBISCAN_KEY=
BASESCAN_KEY=

# ── deploy inputs ──────────────────────────────────────────────────
# Resolve ONCE on Ethereum mainnet, verify against the bankon.eth subname
# registrar, then pin. This address is eternal on every chain — resolve twice.
#   cast resolve-name bankon.eth --rpc-url $ETHEREUM_RPC
BANKON_ETH_RESOLVED=0x0000000000000000000000000000000000000000
DEPLOYER_PK=
LZ_ENDPOINT_V2=                        # per-chain LayerZero V2 endpoint
ARC_EID=                               # LayerZero endpoint id for Circle Arc (hub)
USDC_NATIVE=                           # native CCTP USDC on the target chain
TOLL_BPS=10                            # legacy Spring toll (Troll uses golden φ, not bps)
